# Copy to .env.local for local development. Never commit real secrets.

# Public base URL of the app
APP_URL=http://localhost:3000

# PostgreSQL (see docker-compose.yml for a local instance)
DATABASE_URL=postgres://enjua:enjua@localhost:5432/enjua

# Better Auth session signing secret (>= 32 random chars). Generate: openssl rand -base64 32
AUTH_SECRET=

# Payment provider: "mock" (development/test) or "midtrans" (TD-08)
PAYMENT_PROVIDER=mock
PAYMENT_ENV=sandbox
# Secret used by MockProvider to sign simulated webhooks (development/test only)
MOCK_PAYMENT_WEBHOOK_SECRET=
# Only for E2E/staging builds (NODE_ENV=production) that use the mock. Never on the live site.
ALLOW_MOCK_PAYMENTS=false
# Midtrans server key for PAYMENT_ENV (use the SANDBOX key outside production). Never commit it.
# Notification URL to configure in the Midtrans dashboard: <APP_URL>/api/webhooks/payments/midtrans
MIDTRANS_SERVER_KEY=

# Object storage: only "local" driver is implemented so far (S3-compatible follows TD-17)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage

# Protects the reservation-expiry cron endpoint (used from Phase 4)
CRON_SECRET=

# Development-only seed admin (scripts/seed-admin.ts). Refused in production.
SEED_ADMIN_NAME=Admin Enjua
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=

LOG_LEVEL=info

# Integration tests: point at a disposable database. If unset, Testcontainers is used (needs Docker).
TEST_DATABASE_URL=
