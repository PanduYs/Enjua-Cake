# Production / staging environment TEMPLATE (plan §37). Placeholders only.
# Real values live in the hosting provider's secret settings — never in Git.
# Validate before deploying:  npm run preflight -- --target=production   (or staging)

NODE_ENV=production
APP_URL=https://<domain-dari-klien>

# PostgreSQL (managed or self-hosted). Use TLS: ...?sslmode=require
# Serverless: use the provider's pooled connection string; migrations need a direct connection.
DATABASE_URL=<postgres-connection-string>
DATABASE_POOL_MAX=5

# openssl rand -base64 48   (generate separately for each environment)
AUTH_SECRET=<random-min-32-chars>
CRON_SECRET=<random-min-32-chars, different from AUTH_SECRET>

# Payments (TD-08). Staging: PAYMENT_ENV=sandbox + Midtrans SANDBOX key (SB-...).
# Production: PAYMENT_ENV=production + Midtrans PRODUCTION key. Never the mock.
PAYMENT_PROVIDER=midtrans
PAYMENT_ENV=production
MIDTRANS_SERVER_KEY=<from-midtrans-dashboard>
ALLOW_MOCK_PAYMENTS=false

# Object storage, S3-compatible (TD-16): two different buckets; the private one is never public.
STORAGE_DRIVER=s3
STORAGE_ENDPOINT=<https-s3-endpoint>
STORAGE_REGION=<region>
STORAGE_ACCESS_KEY_ID=<access-key-id>
STORAGE_SECRET_ACCESS_KEY=<secret-access-key>
STORAGE_PUBLIC_BUCKET=<public-bucket-name>
STORAGE_PRIVATE_BUCKET=<private-bucket-name>

LOG_LEVEL=info
