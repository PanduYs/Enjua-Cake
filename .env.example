# Copy to .env.local for local development. Never commit real secrets.

# Public base URL of the app
APP_URL=http://localhost:3000

# PostgreSQL (see docker-compose.yml for a local instance)
DATABASE_URL=postgres://enjua:enjua@localhost:5432/enjua

# Better Auth session signing secret (>= 32 random chars). Generate: openssl rand -base64 32
AUTH_SECRET=

# Payment provider: only "mock" is implemented in Phase 1
PAYMENT_PROVIDER=mock
PAYMENT_ENV=sandbox
# Secret used by MockProvider to sign simulated webhooks (development/test only)
MOCK_PAYMENT_WEBHOOK_SECRET=

# Object storage: only "local" driver is implemented in Phase 1
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage

# Protects the reservation-expiry cron endpoint (used from Phase 4)
CRON_SECRET=

# Development-only seed admin (scripts/seed-admin.ts). Refused in production.
SEED_ADMIN_NAME=Admin Enjua
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=

LOG_LEVEL=info

# Integration tests: point at a disposable database. If unset, Testcontainers is used (needs Docker).
TEST_DATABASE_URL=
